# Chiave API Anthropic (Claude) — usata per organizzare/correggere/ampliare gli appunti
ANTHROPIC_API_KEY=sk-ant-...

# Trascrizione di file audio e registrazioni (endpoint compatibile Whisper /audio/transcriptions).
# Facoltativo: senza, l'app funziona comunque con la "Dettatura live" del browser.
# OpenAI:  https://api.openai.com/v1/audio/transcriptions   modello: whisper-1
# Groq:    https://api.groq.com/openai/v1/audio/transcriptions  modello: whisper-large-v3
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Password condivisa per proteggere il sito quando è online (facoltativa ma consigliata)
APP_PASSWORD=

PORT=3000
